{
  "name": "gitmin",
  "displayName": "GitMin",
  "description": "%extension.description%",
  "version": "0.1.2",
  "publisher": "liumin",
  "repository": {
    "type": "git",
    "url": "https://github.com/liumin1128/gitmin.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "configuration": {
      "title": "GitMin",
      "properties": {
        "gitmin.commitMessageLanguage": {
          "type": "string",
          "enum": [
            "en",
            "zh"
          ],
          "enumItemLabels": [
            "%configuration.commitMessageLanguage.en.label%",
            "%configuration.commitMessageLanguage.zh.label%"
          ],
          "enumDescriptions": [
            "%configuration.commitMessageLanguage.en.description%",
            "%configuration.commitMessageLanguage.zh.description%"
          ],
          "default": "en",
          "description": "%configuration.commitMessageLanguage.description%"
        },
        "gitmin.commitMessageModel": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "%configuration.commitMessageModel.description%"
        },
        "gitmin.customModel.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "%configuration.customModel.enabled.description%"
        },
        "gitmin.customModel.baseUrl": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "%configuration.customModel.baseUrl.description%"
        },
        "gitmin.customModel.model": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "%configuration.customModel.model.description%"
        },
        "gitmin.commitMessagePrompt": {
          "type": "string",
          "default": "",
          "scope": "window",
          "editPresentation": "multilineText",
          "markdownDescription": "%configuration.commitMessagePrompt.description%"
        }
      }
    },
    "commands": [
      {
        "command": "gitmin.openPanel",
        "title": "%command.openPanel.title%",
        "category": "GitMin",
        "icon": "$(link-external)"
      },
      {
        "command": "gitmin.openSettings",
        "title": "%command.openSettings.title%",
        "category": "GitMin",
        "icon": "$(gear)"
      },
      {
        "command": "gitmin.selectCommitMessageModel",
        "title": "%command.selectCommitMessageModel.title%",
        "category": "GitMin"
      },
      {
        "command": "gitmin.setCustomModelApiKey",
        "title": "%command.setCustomModelApiKey.title%",
        "category": "GitMin"
      },
      {
        "command": "gitmin.previousFileDiff",
        "title": "%command.previousFileDiff.title%",
        "category": "GitMin",
        "icon": "$(arrow-left)",
        "enablement": "gitmin.fileDiffActive"
      },
      {
        "command": "gitmin.nextFileDiff",
        "title": "%command.nextFileDiff.title%",
        "category": "GitMin",
        "icon": "$(arrow-right)",
        "enablement": "gitmin.fileDiffActive"
      },
      {
        "command": "gitmin.toggleRepositoriesView",
        "title": "%view.repositories%",
        "category": "GitMin"
      },
      {
        "command": "gitmin.toggleRepositoriesView.checked",
        "title": "%view.repositories%",
        "category": "GitMin",
        "icon": "$(check)"
      },
      {
        "command": "gitmin.toggleChangesView",
        "title": "%view.changes%",
        "category": "GitMin"
      },
      {
        "command": "gitmin.toggleChangesView.checked",
        "title": "%view.changes%",
        "category": "GitMin",
        "icon": "$(check)"
      },
      {
        "command": "gitmin.toggleCommitsView",
        "title": "%view.commits%",
        "category": "GitMin"
      },
      {
        "command": "gitmin.toggleCommitsView.checked",
        "title": "%view.commits%",
        "category": "GitMin",
        "icon": "$(check)"
      },
      {
        "command": "gitmin.toggleStashesView",
        "title": "%view.stashes%",
        "category": "GitMin"
      },
      {
        "command": "gitmin.toggleStashesView.checked",
        "title": "%view.stashes%",
        "category": "GitMin",
        "icon": "$(check)"
      },
      {
        "command": "gitmin.toggleChangedFilesView",
        "title": "%view.changedFiles%",
        "category": "GitMin"
      },
      {
        "command": "gitmin.toggleChangedFilesView.checked",
        "title": "%view.changedFiles%",
        "category": "GitMin",
        "icon": "$(check)"
      },
      {
        "command": "gitmin.toggleCommitDetailsView",
        "title": "%view.commitDetails%",
        "category": "GitMin"
      },
      {
        "command": "gitmin.toggleCommitDetailsView.checked",
        "title": "%view.commitDetails%",
        "category": "GitMin",
        "icon": "$(check)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitmin",
          "title": "GitMin",
          "icon": "$(git-commit)"
        }
      ]
    },
    "views": {
      "gitmin": [
        {
          "id": "gitmin.panel",
          "name": "GitMin",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "gitmin.openSettings",
          "when": "activeWebviewPanelId == gitmin.panel",
          "group": "navigation@100"
        },
        {
          "command": "gitmin.previousFileDiff",
          "when": "gitmin.fileDiffActive",
          "group": "navigation@12"
        },
        {
          "command": "gitmin.nextFileDiff",
          "when": "gitmin.fileDiffActive",
          "group": "navigation@13"
        }
      ],
      "view/title": [
        {
          "command": "gitmin.openPanel",
          "when": "view == gitmin.panel",
          "group": "navigation"
        },
        {
          "command": "gitmin.openSettings",
          "when": "view == gitmin.panel",
          "group": "navigation@100"
        },
        {
          "command": "gitmin.toggleRepositoriesView",
          "when": "view == gitmin.panel && !gitmin.workbenchView.repositories.visible",
          "group": "1_views@1"
        },
        {
          "command": "gitmin.toggleRepositoriesView.checked",
          "when": "view == gitmin.panel && gitmin.workbenchView.repositories.visible",
          "group": "1_views@1"
        },
        {
          "command": "gitmin.toggleChangesView",
          "when": "view == gitmin.panel && !gitmin.workbenchView.changes.visible",
          "group": "1_views@2"
        },
        {
          "command": "gitmin.toggleChangesView.checked",
          "when": "view == gitmin.panel && gitmin.workbenchView.changes.visible",
          "group": "1_views@2"
        },
        {
          "command": "gitmin.toggleCommitsView",
          "when": "view == gitmin.panel && !gitmin.workbenchView.commits.visible",
          "group": "1_views@3"
        },
        {
          "command": "gitmin.toggleCommitsView.checked",
          "when": "view == gitmin.panel && gitmin.workbenchView.commits.visible",
          "group": "1_views@3"
        },
        {
          "command": "gitmin.toggleStashesView",
          "when": "view == gitmin.panel && !gitmin.workbenchView.stashes.visible",
          "group": "1_views@4"
        },
        {
          "command": "gitmin.toggleStashesView.checked",
          "when": "view == gitmin.panel && gitmin.workbenchView.stashes.visible",
          "group": "1_views@4"
        },
        {
          "command": "gitmin.toggleChangedFilesView",
          "when": "view == gitmin.panel && !gitmin.workbenchView.files.visible",
          "group": "1_views@5"
        },
        {
          "command": "gitmin.toggleChangedFilesView.checked",
          "when": "view == gitmin.panel && gitmin.workbenchView.files.visible",
          "group": "1_views@5"
        },
        {
          "command": "gitmin.toggleCommitDetailsView",
          "when": "view == gitmin.panel && !gitmin.workbenchView.details.visible",
          "group": "1_views@6"
        },
        {
          "command": "gitmin.toggleCommitDetailsView.checked",
          "when": "view == gitmin.panel && gitmin.workbenchView.details.visible",
          "group": "1_views@6"
        }
      ],
      "commandPalette": [
        {
          "command": "gitmin.toggleRepositoriesView.checked",
          "when": "false"
        },
        {
          "command": "gitmin.toggleChangesView.checked",
          "when": "false"
        },
        {
          "command": "gitmin.toggleCommitsView.checked",
          "when": "false"
        },
        {
          "command": "gitmin.toggleStashesView.checked",
          "when": "false"
        },
        {
          "command": "gitmin.toggleChangedFilesView.checked",
          "when": "false"
        },
        {
          "command": "gitmin.toggleCommitDetailsView.checked",
          "when": "false"
        }
      ]
    }
  },
  "extensionDependencies": [
    "vscode.git"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "test:app-commit-pagination": "node test/runTsxTest.mjs test/appCommitPagination.ts",
    "test:commit-pagination": "node test/runTsxTest.mjs test/commitPagination.mts",
    "test:commit-details": "node --experimental-strip-types test/commitDetails.mts && node test/runTsxTest.mjs test/commitDetailsPanel.tsx",
    "test:commit-graph": "node --experimental-strip-types test/commitGraph.mts && node test/runTsxTest.mjs test/commitGraphSVG.tsx",
    "test:persisted-filters": "node --experimental-strip-types test/persistedFilters.mts",
    "test:working-tree": "node --experimental-strip-types test/workingTree.mts && node test/runTsxTest.mjs test/gitWorkspaceServices.mts",
    "test:stashes": "node --experimental-strip-types test/stashParser.mts",
    "test:workbench-changes": "node --experimental-strip-types test/detailSelection.mts && node --experimental-strip-types test/workingTreeDiff.mts && node --experimental-strip-types test/workingTree.mts && node test/runTsxTest.mjs test/commitMessage.mts && node test/runTsxTest.mjs test/customModelClient.ts && node test/runTsxTest.mjs test/workbenchChanges.tsx",
    "test:repositories": "node test/runTsxTest.mjs test/repositories.mts && node test/runTsxTest.mjs test/repositoryList.tsx",
    "test:i18n": "node test/runTsxTest.mjs test/i18n.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
