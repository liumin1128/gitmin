{
  "name": "gitmin",
  "displayName": "GitMin",
  "description": "WebStorm-like Git commit management panel for VSCode",
  "version": "0.0.5",
  "publisher": "liumin",
  "repository": {
    "type": "git",
    "url": "https://github.com/liumin1128/gitmin.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "gitmin.openPanel",
        "title": "GitMin: Open Panel in Editor",
        "category": "GitMin",
        "icon": "$(link-external)"
      },
      {
        "command": "gitmin.previousFileDiff",
        "title": "GitMin: Previous File Diff",
        "category": "GitMin",
        "icon": "$(arrow-left)",
        "enablement": "gitmin.fileDiffActive"
      },
      {
        "command": "gitmin.nextFileDiff",
        "title": "GitMin: Next File Diff",
        "category": "GitMin",
        "icon": "$(arrow-right)",
        "enablement": "gitmin.fileDiffActive"
      },
      {
        "command": "gitmin.toggleChangesView",
        "title": "Changes",
        "category": "GitMin"
      },
      {
        "command": "gitmin.toggleCommitsView",
        "title": "Commits",
        "category": "GitMin"
      },
      {
        "command": "gitmin.toggleStashesView",
        "title": "Stashes",
        "category": "GitMin"
      },
      {
        "command": "gitmin.toggleChangedFilesView",
        "title": "Changed Files",
        "category": "GitMin"
      },
      {
        "command": "gitmin.toggleCommitDetailsView",
        "title": "Commit Details",
        "category": "GitMin"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitmin",
          "title": "GitMin",
          "icon": "$(git-commit)"
        }
      ]
    },
    "views": {
      "gitmin": [
        {
          "id": "gitmin.panel",
          "name": "GitMin",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "gitmin.previousFileDiff",
          "when": "gitmin.fileDiffActive",
          "group": "navigation@12"
        },
        {
          "command": "gitmin.nextFileDiff",
          "when": "gitmin.fileDiffActive",
          "group": "navigation@13"
        }
      ],
      "view/title": [
        {
          "command": "gitmin.openPanel",
          "when": "view == gitmin.panel",
          "group": "navigation"
        },
        {
          "command": "gitmin.toggleChangesView",
          "when": "view == gitmin.panel",
          "group": "1_views@1",
          "toggled": "gitmin.workbenchView.changes.visible"
        },
        {
          "command": "gitmin.toggleCommitsView",
          "when": "view == gitmin.panel",
          "group": "1_views@2",
          "toggled": "gitmin.workbenchView.commits.visible"
        },
        {
          "command": "gitmin.toggleStashesView",
          "when": "view == gitmin.panel",
          "group": "1_views@3",
          "toggled": "gitmin.workbenchView.stashes.visible"
        },
        {
          "command": "gitmin.toggleChangedFilesView",
          "when": "view == gitmin.panel",
          "group": "1_views@4",
          "toggled": "gitmin.workbenchView.files.visible"
        },
        {
          "command": "gitmin.toggleCommitDetailsView",
          "when": "view == gitmin.panel",
          "group": "1_views@5",
          "toggled": "gitmin.workbenchView.details.visible"
        }
      ]
    }
  },
  "extensionDependencies": [
    "vscode.git"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "test:app-commit-pagination": "node test/runTsxTest.mjs test/appCommitPagination.ts",
    "test:commit-pagination": "node test/runTsxTest.mjs test/commitPagination.mts",
    "test:commit-details": "node --experimental-strip-types test/commitDetails.mts && node test/runTsxTest.mjs test/commitDetailsPanel.tsx",
    "test:commit-graph": "node --experimental-strip-types test/commitGraph.mts && node test/runTsxTest.mjs test/commitGraphSVG.tsx",
    "test:persisted-filters": "node --experimental-strip-types test/persistedFilters.mts",
    "test:working-tree": "node --experimental-strip-types test/workingTree.mts && node test/runTsxTest.mjs test/gitWorkspaceServices.mts",
    "test:stashes": "node --experimental-strip-types test/stashParser.mts",
    "test:workbench-changes": "node --experimental-strip-types test/detailSelection.mts && node --experimental-strip-types test/workingTreeDiff.mts && node test/runTsxTest.mjs test/workbenchChanges.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
